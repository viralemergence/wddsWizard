{
  "description":"translates from WDDS to GBIF IPT metadata profile. Items with no translation target may be added to the description",
  "not_translated":{
    "alternateIdentifier":"https://sbclter.msi.ucsb.edu/external/InformationManagement/EML_211_schema/docs/eml-2.1.1/eml-resource.html#alternateIdentifier",
    "metadataProvider": "https://sbclter.msi.ucsb.edu/external/InformationManagement/EML_211_schema/docs/eml-2.1.1/eml-resource.html#metadataProvider",
    "associatedParty": "https://sbclter.msi.ucsb.edu/external/InformationManagement/EML_211_schema/docs/eml-2.1.1/eml-resource.html#associatedParty",
    "contact":"https://sbclter.msi.ucsb.edu/external/InformationManagement/EML_211_schema/docs/eml-2.1.1/eml-resource.html#contact",
    ""




  },
  "translations":{
    "creators":{
      "targets":["creator","??responsibleParty"],
      "translations":{
        "name":{
          "targets":["surName"],
          "type":"string"
        },
        "familyName":{
          "targets":["surName"],
          "type":"string"
        },
        "givenName":{
          "targets":["givenName"],
          "type":"string"
        },
        "affiliationIdentifier":{
          "targets":["affiliation"],
          "type":"string"
        },
        "nameIdentifier":{
          "targets":["orcid"],
          "type":"string"
        }
      },
      "type":"array_of_objects",
      "flatten":false
    },

    "titles":{
      "targets":["title"],
      "translations":{
        "title":{
          "targets":["title"],
          "type":"string"
        }
      },
      "type":"string",
      "flatten":true
    },

    "publicationYear":{
      "targets":["pubDate"],
      "translations":{
        "pubDate":{
          "targets":["pubDate"],
          "type":"yearDate"
        }
      },
      "type":"string",
      "flatten":true
    },
    "identifier":{
      "targets":["identifier"],
      "translations":{
        "identifier":{
          "targets":["identifier"],
          "type": "string"
        }
      },
      "type":"string",
      "flatten":true
    },
    "subjects":{
      "targets":["subject"],
      "translations":{
        "subject":{
        "targets":["keywords"],
        "type":"string"
        }
      },
      "type":"object",
      "isArray":true,
      "flatten":false
    },
    "rights":{
      "targets":["license"],
      "translations":{
        "rights":{
          "targets":["license"],
          "type":"string"
          }
        },
      "type":"string",
      "flatten":true
    },
    "descriptions":{
      "targets":["additionalInfo","abstract"],
      "translations":{
        "additionalInfo":{
          "targets":["additionalInfo"],
          "type":"string",
          "descriptionType":"Other"
          },
        "abstract":{
          "targets":["abstract"],
          "type":"string",
          "descriptionType":"Abstract"
          }
        },
      "type":"string",
      "flatten":true
    },
    "language":{
      "targets":["language"],
      "translations":{
        "language":{
          "targets":["language"],
          "type":"string"
          }
        },
      "type":"string",
      "flatten":true
    },
    "relatedIdentifiers":{
      "targets":["relation"],
      "translations":{
        "relatedIdentifier":{
          "targets":["identifier"],
          "type":"string"
        },
        "relationType":{
          "targets":["relation"],
          "type":"string"
        }
      },
      "type":"array_of_objects",
      "flatten":false
    }
  }
}
